# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NUXT_TURNSTILE_SECRET_KEY=        # Server-side secret key
NUXT_PUBLIC_TURNSTILE_SITE_KEY=   # Public site key (safe to expose)

# Resend — https://resend.com/api-keys
NUXT_RESEND_API_KEY=              # API key for transactional email

# Supabase — https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=                     # Project URL (e.g. https://xxxx.supabase.co)
SUPABASE_ANON_KEY=                # Anon/public key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=        # Service role key — keep secret, used by CI for migrations

# Site
SITE_URL=https://mschir.dev       # Canonical site URL
PORT=3002                         # Port the Nuxt server listens on in production
NODE_ENV=production